{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "vite.config.ts",
    "../adapters/source-local/src/dicom-parser.d.ts",
    "../adapters/codec-wasm/src/jpeg-lossless-decoder-js.d.ts"
  ]
}
