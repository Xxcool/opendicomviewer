{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node"]
  },
  "include": [
    "domain/**/*",
    "ports/**/*",
    "pipeline/**/*",
    "volume/**/*",
    "testing/**/*",
    "tests/**/*",
    "index.ts"
  ]
}
